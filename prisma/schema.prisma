// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// UNIT HUNIAN
// ============================================================

model HouseholdUnit {
  id         String   @id @default(cuid())
  unitNumber String   @unique  // "02-01", "A-01", dst
  address    String?           // deskripsi opsional: "Jalur 2 No. 1"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  members  User[]
  payments IplPayment[]

  @@map("household_units")
}

// ============================================================
// IPL CONFIG — nominal IPL configurable + audit trail
// ============================================================

model IplConfig {
  id            String   @id @default(cuid())
  amount        Int               // nominal IPL dalam rupiah
  effectiveFrom DateTime          // berlaku mulai tanggal ini
  note          String?           // alasan perubahan (opsional)
  createdAt     DateTime @default(now())
  createdById   String            // admin yang mengubah

  createdBy User @relation("IplConfigCreatedBy", fields: [createdById], references: [id])

  @@map("ipl_configs")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  password    String
  phone       String?
  address     String?    // alamat teks bebas saat daftar
  houseNumber String?    // legacy field — superseded oleh householdId
  role        Role       @default(WARGA)
  status      UserStatus @default(PENDING)
  householdId String?    // null sampai admin assign ke unit
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  household         HouseholdUnit?  @relation(fields: [householdId], references: [id])
  panicAlerts       PanicAlert[]
  communityEvents   CommunityEvent[]
  pushSubscriptions PushSubscription[]
  paidIplPayments   IplPayment[]    @relation("PaymentPaidBy")
  createdIplConfigs IplConfig[]     @relation("IplConfigCreatedBy")

  @@map("users")
}

enum Role {
  WARGA
  PETUGAS_SAMPAH
  ADMIN
}

enum UserStatus {
  PENDING    // baru daftar, menunggu verifikasi admin
  ACTIVE     // sudah diverifikasi + di-assign ke unit
  SUSPENDED  // dinonaktifkan
}

// ============================================================
// IPL (IURAN PENGANGKUTAN SAMPAH)
// ============================================================

model IplPayment {
  id            String        @id @default(cuid())
  householdId   String                                  // per unit, bukan per orang
  paidByUserId  String?                                 // siapa yang membayar (audit trail)
  amount        Int                                     // snapshot dari IplConfig.amount saat generate
  month         Int                                     // 1-12
  year          Int
  status        PaymentStatus @default(UNPAID)
  dueDate       DateTime?                               // tanggal jatuh tempo (tgl 10 bulan tsb)
  paymentDate   DateTime?
  receiptNumber String?
  method        String?                                 // "TUNAI" | "TRANSFER" | "QRIS" | "LAINNYA"
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  household HouseholdUnit @relation(fields: [householdId], references: [id])
  paidBy    User?         @relation("PaymentPaidBy", fields: [paidByUserId], references: [id])

  @@unique([householdId, month, year])
  @@map("ipl_payments")
}

enum PaymentStatus {
  UNPAID
  PAID
  OVERDUE
}

// ============================================================
// PANIC BUTTON / ALERT DARURAT
// ============================================================

model PanicAlert {
  id          String    @id @default(cuid())
  userId      String
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
  isResolved  Boolean   @default(false)
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("panic_alerts")
}

// ============================================================
// INFO EVENT / PENGUMUMAN WARGA
// ============================================================

model CommunityEvent {
  id         String        @id @default(cuid())
  authorId   String
  title      String
  content    String        @db.Text
  category   EventCategory
  eventDate  DateTime?     // tanggal acara (opsional)
  archivedAt DateTime?     // null = aktif; terisi = diarsipkan oleh admin
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("community_events")
}

enum EventCategory {
  DUKA_CITA
  PENGUMUMAN
  KEGIATAN
  LAINNYA
}

// ============================================================
// CCTV CAMERAS
// ============================================================

model CctvCamera {
  id         String   @id @default(cuid())
  name       String   // "Gerbang Utama"
  location   String   // "Depan pos satpam"
  youtubeUrl String   // YouTube embed URL
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cctv_cameras")
}

// ============================================================
// WEB PUSH SUBSCRIPTIONS
// ============================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}
