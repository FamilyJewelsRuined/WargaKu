# Database (Prisma Postgres - console.prisma.io)
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Auth.js v5
AUTH_SECRET="your-secret-here-run-npx-auth-secret"

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@wargaku.id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WargaKu"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-your-key-here"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-key-here"
MIDTRANS_IS_PRODUCTION="false"

# Prisma Object Storage (T3 Storage — S3 Compatible)
# Dapatkan credentials di console.prisma.io → Storage
S3_ENDPOINT="https://t3.storage.dev"
S3_ACCESS_KEY_ID="tid_your-access-key-id"
S3_SECRET_ACCESS_KEY="tsec_your-secret-access-key"
S3_BUCKET="your-bucket-name"
